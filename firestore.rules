rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() && request.auth.token.email == 'admin@poubcoin.tn';
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- reports ----------
    match /reports/{reportId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isOwner(resource.data.userId) && resource.data.status == 'pending');
      allow delete: if isAdmin()
        || isOwner(resource.data.userId);
    }

    // ---------- wallets ----------
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- transactions ----------
    match /transactions/{uid}/items/{txId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- messages ----------
    match /messages/{reportId}/items/{msgId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // ---------- sponsors ----------
    match /sponsors/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ---------- challenges / neighborhoodChallenges ----------
    match /challenges/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /neighborhoodChallenges/{id} {
      allow read: if isAuth();
      allow update: if isAuth()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['current', 'participants']);
      allow write: if isAdmin();
    }

    // ---------- leaderboard / municipalities / settings ----------
    match /leaderboard/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /municipalities/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ---------- vouchers ----------
    match /vouchers/{id} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------- fallback : everything else blocked ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
